# Copy to .env and edit. Every value is optional; defaults are shown.

# Ollama (local LLM)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# Static store the app reads at runtime (built by `python ingest.py`)
# STORE_DIR=./data
# CHROMA_DIR=./chroma_db

# Source files, only used by ingest.py (default: the workspace folder above this one)
# DATA_DIR=..
# WORKBOOK_PATH=../Sample_Customer_Data.xlsx
# POLICY_PDF_PATH=../Detailed_Sample_Refund_Policy.pdf

# Retrieval: auto (Chroma if built + installed, else keyword) | true (require Chroma) | false (keyword only)
USE_EMBEDDINGS=auto
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2   (used by ingest; recorded in the index)

# "Today" for the 30-day refund window. The sample orders are dated July 2026, so on the
# real current date all of them are past the window. Set this to demo an eligible refund.
# REFERENCE_DATE=2026-07-20

# Mask email/phone in customer answers
MASK_PII=true

# Streamlit -> FastAPI
API_URL=http://127.0.0.1:8000
